.env
.env.*
*.env
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
venv*/
ENV/
env/
.venv/
env.bak/
venv.bak/

# Django Database & Static/Media Uploads
*.sqlite3
*.sqlite3-journal
db.sqlite3
/media/
/staticfiles/
local_settings.py
*.log
logs/

# Node.js & Frontend Build Outputs
node_modules/
/frontend/node_modules/
/frontend/dist/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/
.turbo/

# Testing & Coverage
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

